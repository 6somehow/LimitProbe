# Copy to .env (ignored by git) or export in the shell. The environment wins over this file.
# Check the setup with:  python -m pipeline doctor <id> --paper-side --agent --live
# Run a paper end to end: python -m pipeline e2e <id> --pdf paper.pdf --run-paper-side --run-agent

# Real key and upstream URL of the model service. Only the relay process ever sees the key.
SOCLAAS_API_KEY=
SOCLAAS_BASE_URL=https://example.invalid/v1

# Interface the relay binds outgoing connections to (default eth0). Empty = ordinary routing.
SOCLAAS_IFACE=eth0

# Model the pipeline records and caches under. Leave unset for the study's x-test-2.
# PIPELINE_MODEL=x-test-2
