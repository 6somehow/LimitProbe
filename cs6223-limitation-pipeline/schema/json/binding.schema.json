{
  "$defs": {
    "BindingKind": {
      "enum": [
        "mechanism_entry",
        "parameter",
        "config_key"
      ],
      "title": "BindingKind",
      "type": "string"
    },
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "Path relative to the repo root.",
          "title": "File",
          "type": "string"
        },
        "line_start": {
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "function": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified name, e.g. module.func.",
          "title": "Function"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source text of the statement.",
          "title": "Snippet"
        }
      },
      "required": [
        "file",
        "line_start"
      ],
      "title": "CodeLocation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Maps a paper-level concept to a code location.",
  "properties": {
    "schema_version": {
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "binding_id": {
      "title": "Binding Id",
      "type": "string"
    },
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "paper_term": {
      "title": "Paper Term",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/BindingKind"
    },
    "code_symbol": {
      "description": "Variable, parameter, config key, or qualified function.",
      "title": "Code Symbol",
      "type": "string"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodeLocation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "certain": {
      "default": true,
      "title": "Certain",
      "type": "boolean"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    }
  },
  "required": [
    "binding_id",
    "artifact_id",
    "paper_term",
    "kind",
    "code_symbol"
  ],
  "title": "Binding",
  "type": "object"
}
