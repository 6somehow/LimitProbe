{
  "$defs": {
    "ClaimKind": {
      "enum": [
        "capability",
        "accuracy",
        "performance",
        "guarantee",
        "other"
      ],
      "title": "ClaimKind",
      "type": "string"
    },
    "DocSource": {
      "enum": [
        "paper",
        "appendix",
        "readme",
        "code_comment",
        "docstring",
        "other"
      ],
      "title": "DocSource",
      "type": "string"
    },
    "TextEvidence": {
      "additionalProperties": false,
      "description": "A verbatim quote from the paper, README, a docstring or a comment.",
      "properties": {
        "quote": {
          "description": "Verbatim text. Gate rule: must occur in the source.",
          "title": "Quote",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/DocSource",
          "default": "paper"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Section, page, table, or README heading.",
          "title": "Locator"
        }
      },
      "required": [
        "quote"
      ],
      "title": "TextEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "mechanism": {
      "title": "Mechanism",
      "type": "string"
    },
    "statement": {
      "title": "Statement",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ClaimKind"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/TextEvidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "claim_id",
    "artifact_id",
    "mechanism",
    "statement",
    "kind",
    "evidence"
  ],
  "title": "Claim",
  "type": "object"
}
