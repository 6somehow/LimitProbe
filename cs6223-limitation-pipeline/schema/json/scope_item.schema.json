{
  "$defs": {
    "DocSource": {
      "enum": [
        "paper",
        "appendix",
        "readme",
        "code_comment",
        "docstring",
        "other"
      ],
      "title": "DocSource",
      "type": "string"
    },
    "ScopeKind": {
      "enum": [
        "interval",
        "set",
        "boolean",
        "free_text"
      ],
      "title": "ScopeKind",
      "type": "string"
    },
    "TextEvidence": {
      "additionalProperties": false,
      "description": "A verbatim quote from the paper, README, a docstring or a comment.",
      "properties": {
        "quote": {
          "description": "Verbatim text. Gate rule: must occur in the source.",
          "title": "Quote",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/DocSource",
          "default": "paper"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Section, page, table, or README heading.",
          "title": "Locator"
        }
      },
      "required": [
        "quote"
      ],
      "title": "TextEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One dimension of the paper's claimed scope, e.g. context length in [4K, 128K].",
  "properties": {
    "schema_version": {
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_id": {
      "title": "Scope Id",
      "type": "string"
    },
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "param": {
      "description": "Paper-level parameter name, e.g. context_length.",
      "title": "Param",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ScopeKind"
    },
    "lower": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lower"
    },
    "upper": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Upper"
    },
    "values": {
      "anyOf": [
        {
          "items": {},
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Values"
    },
    "unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unit"
    },
    "explicit": {
      "default": true,
      "description": "False when inferred only from what the evaluation covered.",
      "title": "Explicit",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/TextEvidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "scope_id",
    "artifact_id",
    "param",
    "kind",
    "evidence"
  ],
  "title": "ScopeItem",
  "type": "object"
}
