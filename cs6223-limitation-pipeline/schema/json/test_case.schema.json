{
  "$defs": {
    "ExecEnv": {
      "enum": [
        "cpu",
        "cpu_mock",
        "simulator",
        "gpu",
        "none"
      ],
      "title": "ExecEnv",
      "type": "string"
    },
    "ExecResult": {
      "enum": [
        "confirmed",
        "refuted",
        "test_error",
        "not_run"
      ],
      "title": "ExecResult",
      "type": "string"
    },
    "OracleType": {
      "enum": [
        "exception",
        "path_hook",
        "differential",
        "metamorphic",
        "resource"
      ],
      "title": "OracleType",
      "type": "string"
    },
    "WitnessType": {
      "enum": [
        "input_value",
        "event_sequence"
      ],
      "title": "WitnessType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.2.1",
      "title": "Schema Version",
      "type": "string"
    },
    "test_id": {
      "title": "Test Id",
      "type": "string"
    },
    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "witness_type": {
      "$ref": "#/$defs/WitnessType"
    },
    "inputs": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Inputs",
      "type": "array"
    },
    "oracle_type": {
      "$ref": "#/$defs/OracleType"
    },
    "oracle_spec": {
      "title": "Oracle Spec",
      "type": "string"
    },
    "executable_on": {
      "$ref": "#/$defs/ExecEnv"
    },
    "file": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "File"
    },
    "result": {
      "$ref": "#/$defs/ExecResult",
      "default": "not_run"
    },
    "result_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Notes"
    }
  },
  "required": [
    "test_id",
    "finding_id",
    "witness_type",
    "inputs",
    "oracle_type",
    "oracle_spec",
    "executable_on"
  ],
  "title": "TestCase",
  "type": "object"
}
