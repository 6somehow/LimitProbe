{
  "$defs": {
    "DocSource": {
      "enum": [
        "paper",
        "appendix",
        "readme",
        "code_comment",
        "docstring",
        "other"
      ],
      "title": "DocSource",
      "type": "string"
    },
    "TextEvidence": {
      "additionalProperties": false,
      "description": "A verbatim quote from the paper, README, a docstring or a comment.",
      "properties": {
        "quote": {
          "description": "Verbatim text. Gate rule: must occur in the source.",
          "title": "Quote",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/DocSource",
          "default": "paper"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Section, page, table, or README heading.",
          "title": "Locator"
        }
      },
      "required": [
        "quote"
      ],
      "title": "TextEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One configuration the paper actually evaluated.",
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "eval_id": {
      "title": "Eval Id",
      "type": "string"
    },
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "config": {
      "additionalProperties": true,
      "description": "Paper-level parameter -> value.",
      "title": "Config",
      "type": "object"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/TextEvidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "eval_id",
    "artifact_id",
    "config",
    "evidence"
  ],
  "title": "EvalPoint",
  "type": "object"
}
