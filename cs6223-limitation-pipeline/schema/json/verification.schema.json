{
  "$defs": {
    "CodeLocation": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "description": "Path relative to the repo root.",
          "title": "File",
          "type": "string"
        },
        "line_start": {
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line End"
        },
        "function": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Qualified name, e.g. module.func.",
          "title": "Function"
        },
        "snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Source text of the statement.",
          "title": "Snippet"
        }
      },
      "required": [
        "file",
        "line_start"
      ],
      "title": "CodeLocation",
      "type": "object"
    },
    "Direction": {
      "enum": [
        "paper_to_code",
        "code_to_paper"
      ],
      "title": "Direction",
      "type": "string"
    },
    "DocSource": {
      "enum": [
        "paper",
        "appendix",
        "readme",
        "code_comment",
        "docstring",
        "other"
      ],
      "title": "DocSource",
      "type": "string"
    },
    "MatchResult": {
      "enum": [
        "found",
        "boundary_mismatch",
        "weaker",
        "not_found",
        "contradicted"
      ],
      "title": "MatchResult",
      "type": "string"
    },
    "ScopeStatus": {
      "enum": [
        "in_scope",
        "scope_edge",
        "out_of_scope",
        "unknown"
      ],
      "title": "ScopeStatus",
      "type": "string"
    },
    "TextEvidence": {
      "additionalProperties": false,
      "description": "A verbatim quote from the paper, README, a docstring or a comment.",
      "properties": {
        "quote": {
          "description": "Verbatim text. Gate rule: must occur in the source.",
          "title": "Quote",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/DocSource",
          "default": "paper"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Section, page, table, or README heading.",
          "title": "Locator"
        }
      },
      "required": [
        "quote"
      ],
      "title": "TextEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verification_id": {
      "title": "Verification Id",
      "type": "string"
    },
    "limitation_id": {
      "title": "Limitation Id",
      "type": "string"
    },
    "direction": {
      "$ref": "#/$defs/Direction"
    },
    "result": {
      "$ref": "#/$defs/MatchResult"
    },
    "documented_in": {
      "items": {
        "$ref": "#/$defs/DocSource"
      },
      "title": "Documented In",
      "type": "array"
    },
    "matching_evidence": {
      "items": {
        "$ref": "#/$defs/TextEvidence"
      },
      "title": "Matching Evidence",
      "type": "array"
    },
    "matching_code": {
      "items": {
        "$ref": "#/$defs/CodeLocation"
      },
      "title": "Matching Code",
      "type": "array"
    },
    "scope_status": {
      "$ref": "#/$defs/ScopeStatus",
      "default": "unknown"
    },
    "evaluated_in_paper": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Does the region contain an EvalPoint?",
      "title": "Evaluated In Paper"
    },
    "verifier": {
      "description": "'human:<name>' or 'llm:<model>'.",
      "title": "Verifier",
      "type": "string"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    }
  },
  "required": [
    "verification_id",
    "limitation_id",
    "direction",
    "result",
    "verifier"
  ],
  "title": "Verification",
  "type": "object"
}
