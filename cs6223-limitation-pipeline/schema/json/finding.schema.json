{
  "$defs": {
    "Confidence": {
      "enum": [
        "mechanical",
        "llm_assisted",
        "llm_only"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "EffectType": {
      "enum": [
        "reject",
        "path_change",
        "resource",
        "performance",
        "accuracy",
        "state",
        "other"
      ],
      "title": "EffectType",
      "type": "string"
    },
    "FindingCategory": {
      "enum": [
        "confirmed",
        "boundary_mismatch",
        "paper_only",
        "undocumented",
        "documented_elsewhere"
      ],
      "title": "FindingCategory",
      "type": "string"
    },
    "Level": {
      "enum": [
        "L1",
        "L2",
        "L3"
      ],
      "title": "Level",
      "type": "string"
    },
    "ScopeStatus": {
      "enum": [
        "in_scope",
        "scope_edge",
        "out_of_scope",
        "unknown"
      ],
      "title": "ScopeStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "finding_id": {
      "title": "Finding Id",
      "type": "string"
    },
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/FindingCategory"
    },
    "level": {
      "$ref": "#/$defs/Level"
    },
    "limitation_ids": {
      "items": {
        "type": "string"
      },
      "title": "Limitation Ids",
      "type": "array"
    },
    "verification_ids": {
      "items": {
        "type": "string"
      },
      "title": "Verification Ids",
      "type": "array"
    },
    "scope_status": {
      "$ref": "#/$defs/ScopeStatus"
    },
    "evaluated_in_paper": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evaluated In Paper"
    },
    "effect_type": {
      "$ref": "#/$defs/EffectType"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "witness_hint": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Concrete values satisfying scope and region condition, for step 5.",
      "title": "Witness Hint"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "priority": {
      "default": 2,
      "description": "1 = highest.",
      "maximum": 3,
      "minimum": 1,
      "title": "Priority",
      "type": "integer"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    }
  },
  "required": [
    "finding_id",
    "artifact_id",
    "category",
    "level",
    "limitation_ids",
    "scope_status",
    "effect_type",
    "summary",
    "confidence"
  ],
  "title": "Finding",
  "type": "object"
}
