{
  "catalog": "data/catalog/papers.json",
  "backend": "heuristic",
  "mode": "discovery",
  "methods": [
    "full",
    "code_only",
    "direct"
  ],
  "max_candidates": 3,
  "max_repo_files": 500,
  "max_file_bytes": 256000,
  "max_profile_claims": 50,
  "max_prompt_characters": 16000,
  "llm_call_limit": 50,
  "llm_token_limit": 200000,
  "runtime_verification": false,
  "model": "gpt-5.6-sol",
  "model_timeout_seconds": 480,
  "generation_batch_mode": "by_method"
}
