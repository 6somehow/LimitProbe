{
  // checklimits agent runtime config (opencode 1.19.5, V1 config schema).
  // The only provider is the local relay: it holds the real key; the key below is a placeholder.
  "$schema": "https://opencode.ai/config.json",
  "model": "relay/x-test-2",
  "small_model": "relay/x-test-2",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "provider": {
    "relay": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "checklimits relay",
      "options": { "baseURL": "http://127.0.0.1:8787/v1", "apiKey": "placeholder-not-a-secret" },
      "models": { "x-test-2": { "name": "x-test-2", "tool_call": true, "reasoning": true,
                                "limit": { "context": 128000, "output": 16000 } } }
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "doom_loop": "deny",
    "bash": {
      "*": "allow",
      "sudo *": "deny", "su *": "deny", "rm -rf *": "deny", "rm -fr *": "deny",
      "git push*": "deny", "git commit*": "deny", "git reset*": "deny", "git checkout*": "deny", "git clean*": "deny",
      "curl *": "deny", "wget *": "deny", "ssh *": "deny", "scp *": "deny", "nc *": "deny",
      "pip install*": "deny", "pip3 install*": "deny", "npm *": "deny", "conda *": "deny",
      "env": "deny", "printenv*": "deny"
    }
  }
}
