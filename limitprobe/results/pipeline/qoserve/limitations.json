    "effect_type": "state",
    "effect_text": "Each Sequence's QoS tier (and hence its deadline) is drawn at random from the global `random` module rather than from any caller-supplied SLA. The tier then drives `self.tier_deadline = TIER_DEADLINES[self.tier]` (line 74) and `_get_TBT_deadline`'s choice of `execution_threshold_batched` when `self.tier > 0` (lines 114-115), so the scheduling decision depends on the process-wide RNG state left by earlier calls (and on any earlier `random.seed`), not on the request.",
    "paper_evidence": [],
    "code_evidence": [
      {
        "file": "sarathi/core/datatypes/sequence.py",
        "line_start": 73,
        "line_end": null,
        "function": "sarathi/core/datatypes/sequence.py::Sequence.__init__",
        "snippet": "self.tier = random.randint(0, NUM_TIERS - 1)"
      }
    ],
    "region_ids": [
      "B001"
    ],
    "provenance": "llm",
    "notes": null
  },
  {
    "schema_version": "0.2.0",
