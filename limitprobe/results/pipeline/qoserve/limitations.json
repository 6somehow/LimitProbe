    "artifact_id": "qoserve",
    "origin": "code",
    "level": null,
    "condition_text": "self.scheduler_type == 'fcfs'",
    "condition": {
      "expr": "self.scheduler_type == 'fcfs'",
      "params": [
        "self"
      ],
      "path_prefix": [
        "Sequence.__init__"
      ]
    },
    "effect_type": "path_change",
    "effect_text": "`Sequence.__lt__` dispatches on this per-object attribute: 'fcfs' orders by arrival_time, 'edf' by ttft_deadline+arrival_time, 'srpf' by remaining prompt tokens, and anything else falls through to the hybrid-prioritization deadline. The attribute is hard-coded to 'fcfs' in the constructor, so unless some other code overwrites it after construction, the priority queue used by the deadline scheduler always runs plain FCFS and the hybrid/EDF/SRPF variants are unreachable.",
    "paper_evidence": [],
    "code_evidence": [
      {
        "file": "sarathi/core/datatypes/sequence.py",
        "line_start": 80,
        "line_end": null,
        "function": "sarathi/core/datatypes/sequence.py::Sequence.__init__",
        "snippet": "self.scheduler_type = 'fcfs'  # default scheduler type"
      }
    ],
    "region_ids": [
      "B002"
    ],
    "provenance": "llm",
    "notes": null
  },
